# AI Microservice Environment Configuration
BACKEND_ORIGIN=https://your-backend.onrender.com

# LLM Selection (options: gemini, openai, ollama)
# For cloud deployment, use gemini or openai (Ollama only works locally)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key

# Optional: OpenAI or Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama fallback (local development only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
